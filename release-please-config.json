{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "9644a341fa170c21174e65228ac2aa67b3895388",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore: publier les versions (${branch})",
  "pull-request-header": "Fusionner cette PR publie les versions ci-dessous (tags, notes de version GitHub) et met la production à jour.",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "application",
      "package-name": "application",
      "exclude-paths": ["data", "derive", "docs"],
      "changelog-sections": [
        { "type": "feat", "section": "Nouveautés" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "revert", "section": "Retours en arrière" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "refactor", "section": "Refonte", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Construction", "hidden": true },
        { "type": "ci", "section": "Intégration continue", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ]
    },
    "data": {
      "release-type": "simple",
      "component": "donnees",
      "package-name": "donnees",
      "changelog-sections": [
        { "type": "feat", "section": "Ajouts (candidats, questions, codages)" },
        { "type": "fix", "section": "Corrections de codage" },
        { "type": "revert", "section": "Retours en arrière" },
        { "type": "docs", "section": "Méthode et documentation" },
        { "type": "refactor", "section": "Réorganisation", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ]
    }
  }
}
